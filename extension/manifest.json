{
  "manifest_version": 3,
  "name": "WatchVid4U · 帮你看视频",
  "short_name": "WatchVid4U",
  "version": "1.0.0",
  "description": "把视频变成可保存的中文逐字稿与学习笔记：B站字幕优先，无字幕自动录音转写，播完自动暂停。",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "WatchVid4U · 帮你看视频",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "options_page": "src/ui/options.html",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://www.youtube.com/*",
        "https://www.douyin.com/*"
      ],
      "js": ["src/shared/uiscale.js", "src/content/detector.js", "src/content/content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "start-current": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "从当前进度开始（字幕优先，必要时录音）"
    },
    "start-beginning": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "从头开始（字幕优先，必要时从开头录音）"
    },
    "stop-save": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "停止并保存当前任务"
    },
    "toggle-float": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "显示或隐藏网页内浮窗"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
